{
  "$comment": "Parameters for the update script. Kept out of code so a run can be scoped without edits.",
  "discovery": {
    "sources": [
      "ycombinator"
    ],
    "keywords": [
      "developer tools",
      "SaaS",
      "API platform",
      "infrastructure",
      "fintech",
      "devops",
      "open source",
      "data"
    ],
    "excludeKeywords": [
      "crypto casino",
      "adult",
      "gambling"
    ],
    "regions": [],
    "minEmployeeCount": null,
    "maxEmployeeCount": null,
    "maxNewPerRun": 25,
    "requireWebsite": true,
    "requireActive": true,
    "excludeNames": [
      "Y Combinator"
    ],
    "$comment_exclude": "excludeNames drops directory entries that are not companies we want to list (YC lists itself, for instance).",
    "preferHiring": true
  },
  "refresh": {
    "$comment": "Per-run caps keep a single invocation bounded and polite.",
    "maxCompaniesPerRun": 60,
    "staleAfterDays": 14,
    "refreshVerifiedWithinDays": 3,
    "requestTimeoutMs": 12000,
    "perHostDelayMs": 1200,
    "maxRetries": 2,
    "userAgent": "stack-radar/1.0 (+https://github.com/; contact via repo issues)"
  },
  "positions": {
    "$comment": "Titles matching excludePatterns are dropped; the directory is about engineering hiring.",
    "includeNonEngineering": true,
    "excludePatterns": [
      "internship",
      "intern ",
      "werkstudent",
      "praktikum"
    ],
    "maxPerCompany": 60
  },
  "keywordVocabulary": {
    "$comment": "Detected in job titles and descriptions to populate detectedKeywords and company keywords. Left-hand side is the canonical tag; right-hand side are the surface forms matched case-insensitively as whole words.",
