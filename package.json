{
  "name": "stack-radar",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/validate-data.mjs && node scripts/sync-public-data.mjs && tsc -b && vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit && tsc -p api/tsconfig.json --noEmit",
    "lint": "eslint .",
    "validate:data": "node scripts/validate-data.mjs",
    "audit:data": "node scripts/audit-data.mjs",
    "audit:data:live": "node scripts/audit-data.mjs --sample 60",
    "verify": "pnpm validate:data && pnpm typecheck && pnpm lint && pnpm build",
    "set-site-url": "node scripts/set-site-url.mjs",
    "typecheck:api": "tsc -p api/tsconfig.json --noEmit",
    "data:gaps": "node scripts/update/gaps.mjs",
    "data:status": "node scripts/update/cli.mjs status",
    "data:brief": "node scripts/update/brief.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^24.5.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.3",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^6.1.1",
    "globals": "^16.4.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.6",
    "zod": "^4.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
